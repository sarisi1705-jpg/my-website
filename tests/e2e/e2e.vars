# Test-only values for the end-to-end server (not secrets).
# Turnstile: Cloudflare's always-pass test secret; the page uses the matching test site key.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
IP_HASH_SALT=e2e-salt
# Alerts go to the fake Telegram server started by playwright.config.ts.
TELEGRAM_BOT_TOKEN=e2e-token
TELEGRAM_CHAT_ID=1000
TELEGRAM_API_BASE=http://127.0.0.1:8799

# Secret Telegram sends with each update so the bot endpoint can trust it.
TELEGRAM_WEBHOOK_SECRET=e2e-webhook-secret
